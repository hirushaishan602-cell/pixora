rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // PIXORA rule — add this match block INSIDE your existing
    // Creativo storage.rules, alongside your current rules.
    // Namespaced under "pixora-projects/" so it can't collide with
    // anything Creativo already stores in Firebase Storage.
    match /pixora-projects/{fileName} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // client-submitted reference photos + admin-uploaded deliverables
    match /pixora-requests/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
  }
}
