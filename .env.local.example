# Copy to .env.local for local development. NEVER commit .env.local.
# Values below are examples/placeholders. Replace with your own project values.

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Server-only Firebase Admin credentials. NEVER prefix these with NEXT_PUBLIC_.
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# Exact email allowed to become the main admin. Keep this server-side.
MAIN_ADMIN_EMAIL=

# Cloudinary unsigned upload config (public by design). For stronger upload abuse protection,
# prefer a signed server-side upload flow instead of an unsigned preset.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=
